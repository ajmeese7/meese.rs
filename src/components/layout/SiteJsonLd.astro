---
import { siteGraph } from "../../utils/identity";

/**
 * Site-wide structured data: this site as a WebSite, plus the Person who runs
 * it. Emitted on every page so any entry point states the same identity.
 */
const graph = siteGraph(Astro.site ?? new URL("https://meese.rs"));
---

<script type="application/ld+json" is:inline set:html={JSON.stringify(graph)} />
