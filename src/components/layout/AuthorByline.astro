---
interface Props {
  aiModel?: string;
}

const aiModel = Astro.props.aiModel?.trim();
---

<div class:list={["author-byline-group", { "author-byline-group--assisted": aiModel }]}>
  <a href="/about/" class="author-byline" rel="author">
    <img
      src="/logomark.svg"
      width="22"
      height="22"
      alt=""
      class="author-byline__avatar"
    />
    <span class="author-byline__by">by <strong>Aaron Meese</strong></span>
  </a>
  {
    aiModel && (
      <details class="author-assistance" data-pagefind-ignore>
        <summary class="author-assistance__summary" aria-label={`AI assistance: ${aiModel} assisted`}>
          <span class="author-assistance__icon" aria-hidden="true" />
          <span class="author-assistance__text"><span>{aiModel} assisted</span></span>
        </summary>
      </details>
    )
  }
</div>
