---
// Injected only by the development integration; never part of the static build.
import BaseLayout from "../layouts/BaseLayout.astro";
import Editor from "./Editor.tsx";
---

<BaseLayout title="Post editor" description="Private post authoring workspace" noindex footer={false}>
  <!-- Save triggers Astro's full reload. Keep the editor island mounted while
       letting a separate preview tab receive the normal refresh. -->
  <script is:inline>
    (function () {
      const Original = window.WebSocket;
      function EditorSocket(url, protocols) {
        const socket = protocols ? new Original(url, protocols) : new Original(url);
        socket.addEventListener("message", function (event) {
          try {
            if (JSON.parse(event.data)?.type === "full-reload") event.stopImmediatePropagation();
          } catch (_) { /* not a Vite JSON frame */ }
        }, true);
        return socket;
      }
      EditorSocket.prototype = Original.prototype;
      Object.setPrototypeOf(EditorSocket, Original);
      window.WebSocket = EditorSocket;
    })();
  </script>
  <Editor client:only="react" />
</BaseLayout>
