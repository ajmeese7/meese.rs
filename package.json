{
  "name": "meese.rs",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Static-first technical writing site, field notes from a builder.",
  "packageManager": "pnpm@11.11.0",
  "scripts": {
    "dev": "astro dev --host",
    "build": "pnpm format:check && pnpm validate:content && pnpm generate:graph && astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node astro.config.test.mjs && vitest run",
    "validate:content": "tsx scripts/validate-content.ts",
    "validate:bimi": "tsx scripts/validate-bimi-svg.ts",
    "generate:graph": "tsx scripts/generate-graph.ts",
    "generate:icons": "tsx scripts/generate-icons.ts",
    "format": "prettier --write \"src/content/posts/**/*.{md,mdx}\"",
    "format:check": "prettier --check \"src/content/posts/**/*.{md,mdx}\""
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.2",
    "@astrojs/mdx": "^8.0.3",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "astro": "^7.3.8",
    "astro-og-canvas": "^0.13.2",
    "canvaskit-wasm": "^0.42.0",
    "sharp": "0.35.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/react": "^7.0.1",
    "@cloudflare/vitest-plugin": "^1.4.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-yaml": "^6.1.3",
    "@codemirror/language": "^6.13.1",
    "@codemirror/legacy-modes": "^6.5.5",
    "@mdxeditor/editor": "^4.3.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.10",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "vitest": "^5.0.4",
    "wrangler": "^4.149.0",
    "yaml": "^2.9.1"
  }
}
